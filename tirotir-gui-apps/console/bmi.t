# ---- توابع کمکی ----
# «صحیح»: عدد اعشاری (مثل ۳٫۰) را به عدد صحیح تبدیل می‌کند (برای اندیس فهرست)
تابع صحیح با x
    بگذار i برابر ۰
    تاوقتی i + ۱ <= x
        بگذار i برابر i + ۱
    بازگردان i
# «خوب»: گرد کردن تا ۶ رقم اعشار و حذف «.0» اضافی از انتهای عدد
تابع خوب با عدد
    بگذار ص برابر عدد * ۱۰۰۰۰۰۰ + ۰٫۵
    بگذار ص برابر (ص - ص % ۱) / ۱۰۰۰۰۰۰
    بگذار م برابر به_متن با ص
    بگذار ن برابر طول با م
    اگر ن > ۲
        اگر م[ن - ۲] == -.- و م[ن - ۱] == -0-
            بگذار خ برابر م[۰]
            بگذار ک برابر ۱
            تاوقتی ک < ن - ۲
                بگذار خ برابر خ + م[ک]
                بگذار ک برابر ک + ۱
            بازگردان خ
    بازگردان م
# ---- برنامه ----
چاپ -=== شاخص توده بدنی ===-
چاپ -وزن (کیلوگرم):-
بگذار س برابر بخوان
بگذار وزن برابر به_عدد با س
چاپ -قد (سانتیمتر):-
بگذار س برابر بخوان
بگذار قد برابر به_عدد با س
بگذار متر برابر قد / ۱۰۰
بگذار شاخص برابر وزن / (متر * متر)
چاپ -BMI: - + خوب با شاخص
اگر شاخص < ۱۸٫۵
    چاپ -وضعیت: کم وزن-
وگرنه اگر شاخص < ۲۵
    چاپ -وضعیت: طبیعی-
وگرنه اگر شاخص < ۳۰
    چاپ -وضعیت: اضافه وزن-
وگرنه
    چاپ -وضعیت: چاقی-
