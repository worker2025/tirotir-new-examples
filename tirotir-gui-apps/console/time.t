# ---- توابع کمکی ----
# «صحیح»: عدد اعشاری (مثل ۳٫۰) را به عدد صحیح تبدیل می‌کند (برای اندیس فهرست)
تابع صحیح با x
    بگذار i برابر ۰
    تاوقتی i + ۱ <= x
        بگذار i برابر i + ۱
    بازگردان i
# «خوب»: گرد کردن تا ۶ رقم اعشار و حذف «.0» اضافی از انتهای عدد
تابع خوب با عدد
    بگذار ص برابر عدد * ۱۰۰۰۰۰۰ + ۰٫۵
    بگذار ص برابر (ص - ص % ۱) / ۱۰۰۰۰۰۰
    بگذار م برابر به_متن با ص
    بگذار ن برابر طول با م
    اگر ن > ۲
        اگر م[ن - ۲] == -.- و م[ن - ۱] == -0-
            بگذار خ برابر م[۰]
            بگذار ک برابر ۱
            تاوقتی ک < ن - ۲
                بگذار خ برابر خ + م[ک]
                بگذار ک برابر ک + ۱
            بازگردان خ
    بازگردان م
# ---- برنامه ----
چاپ -=== ثانیه به روز، ساعت، دقیقه ===-
چاپ -تعداد ثانیه را وارد کنید:-
بگذار س برابر بخوان
بگذار کل برابر به_عدد با س
بگذار روز برابر (کل - کل % ۸۶۴۰۰) / ۸۶۴۰۰
بگذار باقی برابر کل % ۸۶۴۰۰
بگذار ساعت برابر (باقی - باقی % ۳۶۰۰) / ۳۶۰۰
بگذار باقی برابر باقی % ۳۶۰۰
بگذار دقیقه برابر (باقی - باقی % ۶۰) / ۶۰
بگذار ثانیه برابر باقی % ۶۰
بگذار الف برابر خوب با روز
بگذار ب برابر خوب با ساعت
بگذار ج برابر خوب با دقیقه
بگذار د برابر خوب با ثانیه
چاپ -روز: - + الف
چاپ -ساعت: - + ب
چاپ -دقیقه: - + ج
چاپ -ثانیه: - + د
