# ---- توابع کمکی ----
# «صحیح»: عدد اعشاری (مثل ۳٫۰) را به عدد صحیح تبدیل می‌کند (برای اندیس فهرست)
تابع صحیح با x
    بگذار i برابر ۰
    تاوقتی i + ۱ <= x
        بگذار i برابر i + ۱
    بازگردان i
# «خوب»: گرد کردن تا ۶ رقم اعشار و حذف «.0» اضافی از انتهای عدد
تابع خوب با عدد
    بگذار ص برابر عدد * ۱۰۰۰۰۰۰ + ۰٫۵
    بگذار ص برابر (ص - ص % ۱) / ۱۰۰۰۰۰۰
    بگذار م برابر به_متن با ص
    بگذار ن برابر طول با م
    اگر ن > ۲
        اگر م[ن - ۲] == -.- و م[ن - ۱] == -0-
            بگذار خ برابر م[۰]
            بگذار ک برابر ۱
            تاوقتی ک < ن - ۲
                بگذار خ برابر خ + م[ک]
                بگذار ک برابر ک + ۱
            بازگردان خ
    بازگردان م
# ---- برنامه ----
بگذار نام‌ها برابر [-کیلوگرم-، -گرم-، -میلیگرم-، -تن-، -پوند-، -اونس-]
بگذار ضریب‌ها برابر [۱، ۰٫۰۰۱، ۰٫۰۰۰۰۰۱، ۱۰۰۰، ۰٫۴۵۳۵۹۲۳۷، ۰٫۰۲۸۳۴۹۵۲۳۱۲۵]
چاپ -=== تبدیل وزن ===-
بگذار ش برابر ۱
برای و در نام‌ها
    بگذار ر برابر به_متن با ش
    چاپ ر + -) - + و
    بگذار ش برابر ش + ۱
چاپ -شمارهٔ واحد مبدأ:-
بگذار س برابر بخوان
بگذار ع برابر به_عدد با س
بگذار الف برابر صحیح با ع
چاپ -شمارهٔ واحد مقصد:-
بگذار س برابر بخوان
بگذار ع برابر به_عدد با س
بگذار ب برابر صحیح با ع
چاپ -مقدار:-
بگذار س برابر بخوان
بگذار مقدار برابر به_عدد با س
بگذار تعداد برابر طول با نام‌ها
اگر الف < ۱ یا الف > تعداد یا ب < ۱ یا ب > تعداد
    چاپ -شمارهٔ واحد درست نیست.-
وگرنه
    بگذار نتیجه برابر مقدار * ضریب‌ها[الف - ۱] / ضریب‌ها[ب - ۱]
    بگذار پ برابر خوب با نتیجه
    بگذار ت برابر خوب با مقدار
    چاپ نام‌ها[الف - ۱] + -: - + ت
    چاپ نام‌ها[ب - ۱] + -: - + پ
