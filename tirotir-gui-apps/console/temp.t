# ---- توابع کمکی ----
# «صحیح»: عدد اعشاری (مثل ۳٫۰) را به عدد صحیح تبدیل می‌کند (برای اندیس فهرست)
تابع صحیح با x
    بگذار i برابر ۰
    تاوقتی i + ۱ <= x
        بگذار i برابر i + ۱
    بازگردان i
# «خوب»: گرد کردن تا ۶ رقم اعشار و حذف «.0» اضافی از انتهای عدد
تابع خوب با عدد
    بگذار ص برابر عدد * ۱۰۰۰۰۰۰ + ۰٫۵
    بگذار ص برابر (ص - ص % ۱) / ۱۰۰۰۰۰۰
    بگذار م برابر به_متن با ص
    بگذار ن برابر طول با م
    اگر ن > ۲
        اگر م[ن - ۲] == -.- و م[ن - ۱] == -0-
            بگذار خ برابر م[۰]
            بگذار ک برابر ۱
            تاوقتی ک < ن - ۲
                بگذار خ برابر خ + م[ک]
                بگذار ک برابر ک + ۱
            بازگردان خ
    بازگردان م
# ---- برنامه ----
چاپ -=== تبدیل دما ===-
چاپ -۱) سلسیوس  ۲) فارنهایت  ۳) کلوین-
چاپ -واحد مبدأ:-
بگذار س برابر بخوان
بگذار الف برابر به_عدد با س
چاپ -واحد مقصد:-
بگذار س برابر بخوان
بگذار ب برابر به_عدد با س
چاپ -مقدار:-
بگذار س برابر بخوان
بگذار مقدار برابر به_عدد با س
# ابتدا به سلسیوس تبدیل می‌کنیم
بگذار سلسیوس برابر مقدار
اگر الف == ۲
    بگذار سلسیوس برابر (مقدار - ۳۲) * ۵ / ۹
اگر الف == ۳
    بگذار سلسیوس برابر مقدار - ۲۷۳٫۱۵
# سپس از سلسیوس به واحد مقصد
بگذار نتیجه برابر سلسیوس
اگر ب == ۲
    بگذار نتیجه برابر سلسیوس * ۹ / ۵ + ۳۲
اگر ب == ۳
    بگذار نتیجه برابر سلسیوس + ۲۷۳٫۱۵
چاپ -نتیجه:-
چاپ خوب با نتیجه
