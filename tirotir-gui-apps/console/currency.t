# ---- توابع کمکی ----
# «صحیح»: عدد اعشاری (مثل ۳٫۰) را به عدد صحیح تبدیل می‌کند (برای اندیس فهرست)
تابع صحیح با x
    بگذار i برابر ۰
    تاوقتی i + ۱ <= x
        بگذار i برابر i + ۱
    بازگردان i
# «خوب»: گرد کردن تا ۶ رقم اعشار و حذف «.0» اضافی از انتهای عدد
تابع خوب با عدد
    بگذار ص برابر عدد * ۱۰۰۰۰۰۰ + ۰٫۵
    بگذار ص برابر (ص - ص % ۱) / ۱۰۰۰۰۰۰
    بگذار م برابر به_متن با ص
    بگذار ن برابر طول با م
    اگر ن > ۲
        اگر م[ن - ۲] == -.- و م[ن - ۱] == -0-
            بگذار خ برابر م[۰]
            بگذار ک برابر ۱
            تاوقتی ک < ن - ۲
                بگذار خ برابر خ + م[ک]
                بگذار ک برابر ک + ۱
            بازگردان خ
    بازگردان م
# ---- برنامه ----
# نرخ ارز ثابت نیست؛ نرخ روز را خودتان وارد می‌کنید
چاپ -=== تبدیل ارز ===-
چاپ -مقدار ارز (مثلاً دلار):-
بگذار س برابر بخوان
بگذار مقدار برابر به_عدد با س
چاپ -نرخ هر واحد به ریال یا تومان:-
بگذار س برابر بخوان
بگذار نرخ برابر به_عدد با س
چاپ -معادل: - + خوب با مقدار * نرخ
