# ---- توابع کمکی ----
# «صحیح»: عدد اعشاری (مثل ۳٫۰) را به عدد صحیح تبدیل می‌کند (برای اندیس فهرست)
تابع صحیح با x
    بگذار i برابر ۰
    تاوقتی i + ۱ <= x
        بگذار i برابر i + ۱
    بازگردان i
# «خوب»: گرد کردن تا ۶ رقم اعشار و حذف «.0» اضافی از انتهای عدد
تابع خوب با عدد
    بگذار ص برابر عدد * ۱۰۰۰۰۰۰ + ۰٫۵
    بگذار ص برابر (ص - ص % ۱) / ۱۰۰۰۰۰۰
    بگذار م برابر به_متن با ص
    بگذار ن برابر طول با م
    اگر ن > ۲
        اگر م[ن - ۲] == -.- و م[ن - ۱] == -0-
            بگذار خ برابر م[۰]
            بگذار ک برابر ۱
            تاوقتی ک < ن - ۲
                بگذار خ برابر خ + م[ک]
                بگذار ک برابر ک + ۱
            بازگردان خ
    بازگردان م
# ---- برنامه ----
تابع خارج با الف و ب
    بازگردان (الف - الف % ب) / ب
بگذار روزهای_ماه برابر [۰، ۳۱، ۵۹، ۹۰، ۱۲۰، ۱۵۱، ۱۸۱، ۲۱۲، ۲۴۳، ۲۷۳، ۳۰۴، ۳۳۴]
بگذار نام_ماه‌ها برابر [-فروردین-، -اردیبهشت-، -خرداد-، -تیر-، -مرداد-، -شهریور-، -مهر-، -آبان-، -آذر-، -دی-، -بهمن-، -اسفند-]
چاپ -=== میلادی به شمسی ===-
چاپ -سال میلادی:-
بگذار س برابر بخوان
بگذار گس برابر به_عدد با س
چاپ -ماه (۱ تا ۱۲):-
بگذار س برابر بخوان
بگذار ع برابر به_عدد با س
بگذار گم برابر صحیح با ع
چاپ -روز:-
بگذار س برابر بخوان
بگذار گر برابر به_عدد با س
اگر گس > ۱۶۰۰
    بگذار جس برابر ۹۷۹
    بگذار گس برابر گس - ۱۶۰۰
وگرنه
    بگذار جس برابر ۰
    بگذار گس برابر گس - ۶۲۱
بگذار گسب برابر گس
اگر گم > ۲
    بگذار گسب برابر گس + ۱
بگذار ا برابر خارج با (گسب + ۳) و ۴
بگذار ب برابر خارج با (گسب + ۹۹) و ۱۰۰
بگذار ج برابر خارج با (گسب + ۳۹۹) و ۴۰۰
بگذار روزها برابر ۳۶۵ * گس + ا - ب + ج - ۸۰ + گر + روزهای_ماه[گم - ۱]
بگذار جس برابر جس + ۳۳ * خارج با روزها و ۱۲۰۵۳
بگذار روزها برابر روزها % ۱۲۰۵۳
بگذار جس برابر جس + ۴ * خارج با روزها و ۱۴۶۱
بگذار روزها برابر روزها % ۱۴۶۱
اگر روزها > ۳۶۵
    بگذار جس برابر جس + خارج با (روزها - ۱) و ۳۶۵
    بگذار روزها برابر (روزها - ۱) % ۳۶۵
اگر روزها < ۱۸۶
    بگذار جم برابر ۱ + خارج با روزها و ۳۱
    بگذار جر برابر ۱ + روزها % ۳۱
وگرنه
    بگذار جم برابر ۷ + خارج با (روزها - ۱۸۶) و ۳۰
    بگذار جر برابر ۱ + (روزها - ۱۸۶) % ۳۰
بگذار سال برابر خوب با جس
بگذار ماه برابر خوب با جم
بگذار روز برابر خوب با جر
چاپ -تاریخ شمسی: - + سال + -/- + ماه + -/- + روز
بگذار ن برابر صحیح با جم
چاپ -نام ماه: - + نام_ماه‌ها[ن - ۱]
