# ---- توابع کمکی ----
# «صحیح»: عدد اعشاری (مثل ۳٫۰) را به عدد صحیح تبدیل می‌کند (برای اندیس فهرست)
تابع صحیح با x
    بگذار i برابر ۰
    تاوقتی i + ۱ <= x
        بگذار i برابر i + ۱
    بازگردان i
# «خوب»: گرد کردن تا ۶ رقم اعشار و حذف «.0» اضافی از انتهای عدد
تابع خوب با عدد
    بگذار ص برابر عدد * ۱۰۰۰۰۰۰ + ۰٫۵
    بگذار ص برابر (ص - ص % ۱) / ۱۰۰۰۰۰۰
    بگذار م برابر به_متن با ص
    بگذار ن برابر طول با م
    اگر ن > ۲
        اگر م[ن - ۲] == -.- و م[ن - ۱] == -0-
            بگذار خ برابر م[۰]
            بگذار ک برابر ۱
            تاوقتی ک < ن - ۲
                بگذار خ برابر خ + م[ک]
                بگذار ک برابر ک + ۱
            بازگردان خ
    بازگردان م
# ---- برنامه ----
چاپ -=== مساحت و محیط ===-
چاپ -۱) مربع  ۲) مستطیل  ۳) دایره-
بگذار س برابر بخوان
بگذار ک برابر به_عدد با س
اگر ک == ۱
    چاپ -طول ضلع:-
    بگذار س برابر بخوان
    بگذار الف برابر به_عدد با س
    چاپ -مساحت: - + خوب با الف * الف
    چاپ -محیط: - + خوب با ۴ * الف
وگرنه اگر ک == ۲
    چاپ -طول:-
    بگذار س برابر بخوان
    بگذار الف برابر به_عدد با س
    چاپ -عرض:-
    بگذار س برابر بخوان
    بگذار ب برابر به_عدد با س
    چاپ -مساحت: - + خوب با الف * ب
    چاپ -محیط: - + خوب با ۲ * (الف + ب)
وگرنه اگر ک == ۳
    چاپ -شعاع:-
    بگذار س برابر بخوان
    بگذار ش برابر به_عدد با س
    چاپ -مساحت: - + خوب با ۳٫۱۴۱۵۹۲۶۵ * ش * ش
    چاپ -محیط: - + خوب با ۲ * ۳٫۱۴۱۵۹۲۶۵ * ش
وگرنه
    چاپ -گزینهٔ نامعتبر-
